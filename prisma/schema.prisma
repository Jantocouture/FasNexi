// Prisma schema for FasNexi
// Run `npx prisma generate` after updating
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CONSUMER
  VENDOR
  DESIGNER
  TAILOR
  CREATOR
  EVENT_ORGANIZER
  SUSTAINABLE_PARTNER
  ADMIN
}

model User {
  id            String   @id @default(cuid())
  username      String   @unique
  email         String   @unique
  passwordHash  String?
  role          Role     @default(CONSUMER)
  avatar        String?
  createdAt     DateTime @default(now())
  // relations
  posts         Post[]
  stories       Story[]
  sentMessages  Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  orders        Order[]
  measurementsAsTailor Measurement[] @relation("TailorMeasurements")
  measurementsAsUser Measurement[] @relation("MeasuredUser")
  certifications Certification[]
}

model Post {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  image       String
  caption     String
  culturalTag String?
  createdAt   DateTime @default(now())
}

model Story {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  image     String
  likes     StoryLike[]
  seenBy    StorySeen[]
  createdAt DateTime @default(now())
}

model StoryLike {
  id      String @id @default(cuid())
  userId  String
  storyId String
  user    User   @relation(fields: [userId], references: [id])
  story   Story  @relation(fields: [storyId], references: [id])
}

model StorySeen {
  id      String @id @default(cuid())
  userId  String
  storyId String
  user    User   @relation(fields: [userId], references: [id])
  story   Story  @relation(fields: [storyId], references: [id])
}

model Vendor {
  id      String   @id @default(cuid())
  name    String
  bio     String?
  logo    String?
  products Product[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String
  price       Float
  image       String
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id])
}

model CartItem {
  id        String  @id @default(cuid())
  userId    String
  productId String
  quantity  Int
}

model Order {
  id          String   @id @default(cuid())
  userId      String
  vendorId    String?
  tailorId    String?
  items       Json
  total       Float
  status      String   @default("PENDING")
  paymentType String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime?
  user        User?    @relation(fields: [userId], references: [id])
}

model PaymentProof {
  id         String   @id @default(cuid())
  orderId    String   @unique
  url        String
  uploadedBy String?
  createdAt  DateTime @default(now())
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  orderId    String?
  content    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
}

model Measurement {
  id         String   @id @default(cuid())
  tailorId   String
  userId     String
  data       Json
  label      String?
  createdAt  DateTime @default(now())
  tailor     User     @relation("TailorMeasurements", fields: [tailorId], references: [id])
  user       User     @relation("MeasuredUser", fields: [userId], references: [id])
}

model CreatorContent {
  id            String   @id @default(cuid())
  creatorId     String
  title         String
  description   String?
  media         String
  affiliateLinks Json?
  views         Int      @default(0)
  earnings      Float    @default(0)
  createdAt     DateTime @default(now())
}

model Event {
  id           String   @id @default(cuid())
  organizerId  String
  title        String
  description  String?
  venue        String?
  startAt      DateTime
  endAt        DateTime?
  price        Float   @default(0)
  capacity     Int?
  createdAt    DateTime @default(now())
}

model Ticket {
  id          String   @id @default(cuid())
  eventId     String
  buyerId     String
  seat        String?
  price       Float
  purchasedAt DateTime @default(now())
}

model Certification {
  id         String   @id @default(cuid())
  partnerId  String
  title      String
  provider   String
  url        String
  issuedAt   DateTime?
  createdAt  DateTime @default(now())
}
